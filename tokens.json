{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Gestão de campo para pavimentação e infraestrutura; uma identidade, dois ritmos.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.082,
          0.369,
          0.937
        ],
        "hex": "#155eef"
      }
    },
    "structure": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.165,
          0.263
        ],
        "hex": "#102a43"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.169,
          0.227
        ],
        "hex": "#172b3a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.322,
          0.392,
          0.467
        ],
        "hex": "#526477"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.965,
          0.973
        ],
        "hex": "#f4f6f8"
      }
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "selected": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.918,
          0.945,
          1
        ],
        "hex": "#eaf1ff"
      }
    },
    "selected-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.286,
          0.678
        ],
        "hex": "#1649ad"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.384,
          0.278
        ],
        "hex": "#176247"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          0.137,
          0.094
        ],
        "hex": "#b42318"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
